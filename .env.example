# Copy this file to `.env` (same folder) and fill in your real keys.
# `.env` is git-ignored — never commit real keys.

# Groq API key for the AI Copilot (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenTopography API key for DEM downloads (https://portal.opentopography.org/)
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# Optional: pin a specific Groq model (auto-resolved from your account if unset)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: restrict CORS to specific origins, comma-separated (default: *)
# ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5500
